# Copy to .env before running Docker Compose. Do not commit the resulting file.
# ForgeGate defaults to http://127.0.0.1:3100; set FORGEGATE_PORT to override.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
FORGEGATE_DEMO_REPO=beherarajesh90/agent-harness
FORGEGATE_APPROVAL_SECRET=replace-with-a-long-random-approval-secret
GITHUB_TOKEN=replace-with-a-fine-grained-read-token
GITHUB_WRITE_TOKEN=replace-with-a-fine-grained-write-token
FORGEGATE_ALLOWED_PATHS=apps/forgegate/src/payment-lab.ts,apps/forgegate/test/payment-lab.test.ts
FORGEGATE_BRANCH_PREFIX=forgegate/demo-
FORGEGATE_MAX_BYTES=250000
FORGEGATE_MAX_FILES=10
POSTGRES_USER=forgegate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=trueforge
